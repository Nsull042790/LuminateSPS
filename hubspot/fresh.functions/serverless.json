{
  "runtime": "nodejs18.x",
  "version": "1.0",
  "environment": {
    "HUBSPOT_PORTAL_ID": "{{ secrets.HUBSPOT_PORTAL_ID }}",
    "HUBSPOT_PRIVATE_APP_TOKEN": "{{ secrets.HUBSPOT_PRIVATE_APP_TOKEN }}",
    "HUBDB_TABLE_ID": "{{ secrets.HUBDB_TABLE_ID }}"
  },
  "secrets": [
    "HUBSPOT_PORTAL_ID",
    "HUBSPOT_PRIVATE_APP_TOKEN",
    "HUBDB_TABLE_ID"
  ],
  "endpoints": {
    "test": {
      "method": "GET",
      "file": "test.js"
    },
    "createprop": {
      "method": "POST",
      "file": "createprop.js"
    },
    "listprops": {
      "method": "GET",
      "file": "listprops.js"
    },
    "uploadfile": {
      "method": "POST",
      "file": "uploadfile.js"
    },
    "deleteprop": {
      "method": "POST",
      "file": "deleteprop.js"
    }
  }
}
